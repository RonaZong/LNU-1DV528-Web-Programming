{{#if flash}}
<p style="padding: 1em; background-color: #ccf">{{ flash }}</p>
{{/if}}

<form method=post>
    <h2>Login</h2>
    <p><input type="text" name="username" id="username" placeholder="Enter Username"></p>
    <p><input type="password" name="password" id="password" placeholder="Enter Password"></p>
    <p><input type="submit" name="doit" value="Login"></p>
</form>
