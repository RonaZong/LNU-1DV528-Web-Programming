{
  "name": "b2-crud-code-snippets",
  "version": "1.0.0",
  "description": "",
  "main": "app.mjs",
  "type": "module",
  "scripts": {
    "start": "node app.mjs",
    "http-server": "npx http-server -p 9001",
    "dev": "nodemon app.mjs",
    "build": "vite build",
    "serve": "vite preview",
    "htmlhint": "npx htmlhint public src || exit 0",
    "stylelint": "npx stylelint **/*.css || exit 0",
    "stylelint:fix": "npx stylelint --fix **/*.css || exit 0",
    "eslint": "eslint . --ext .js,.mjs,.cjs",
    "eslint:fix": "eslint . --ext .js,.mjs,.cjs --fix",
    "jsdoc": "npx jsdoc -c .jsdoc.json || exit 0",
    "lint": "npm run eslint",
    "test": "npm run lint",
    "clean": "rm -rf build/",
    "clean-all": "npm run clean && rm -rf node_modules/ && rm -f package-lock.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "htmlhint": "^1.2.0",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.4",
    "nodemon": "^3.1.14",
    "stylelint": "^16.19.1",
    "stylelint-config-recommended": "^16.0.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.5.0",
    "ejs": "7.0.2",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0"
  }
}
