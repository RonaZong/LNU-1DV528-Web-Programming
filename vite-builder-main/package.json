{
  "name": "vite-builder",
  "version": "1.0.0",
  "description": "--- revision:     \"2022-11-88\": \"(A, mos) First release.\" --- Get going with the Vite build tool (Hello World Vite) ===========================",
  "main": "index.js",
  "scripts": {
    "htmlhint": "npx htmlhint ./src || exit 0",
    "stylelint": "npx stylelint \"./src/**/*.css\" || exit 0",
    "stylelint:fix": "npx stylelint --fix \"./src/**/*.css\" || exit 0",
    "eslint": "npx eslint . || exit 0",
    "eslint:fix": "npx eslint . --fix || exit 0",
    "jsdoc": "npx jsdoc -c .jsdoc.json || exit 0",
    "lint": "npm run htmlhint && npm run stylelint && npm run eslint",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "clean": "rm -rf build/",
    "clean-all": "npm run clean && rm -rf node_modules/ && rm -f package-lock.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/mikael-roos/vite-builder.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/mikael-roos/vite-builder/issues"
  },
  "homepage": "https://gitlab.com/mikael-roos/vite-builder#readme",
  "devDependencies": {
    "eslint": "^8.28.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^39.6.4",
    "eslint-plugin-n": "^15.5.1",
    "eslint-plugin-promise": "^6.1.1",
    "htmlhint": "^1.1.4",
    "jsdoc": "^4.0.0",
    "stylelint": "^14.15.0",
    "vite": "^3.2.4"
  }
}
